{
  "name": "@identyclaw/openclaw-identyclaw-httpbearer-plugin",
  "version": "0.1.1",
  "description": "OpenClaw plugin \u2014 opaque bearer session storage and authenticated HTTPS for guest APIs (no IdentyClaw passport)",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/unit.mjs",
    "prepare:publish": "npm test && node ./scripts/verify-pack.mjs",
    "publish:clawhub:dry-run": "node ./scripts/publish-clawhub.mjs --dry-run",
    "publish:clawhub": "node ./scripts/publish-clawhub.mjs"
  },
  "keywords": [
    "identyclaw",
    "openclaw",
    "bearer",
    "jwt",
    "http",
    "guest-auth",
    "clawhub"
  ],
  "author": "IdentyClaw",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discernible-io/openclaw-identyclaw-httpbearer-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/discernible-io/openclaw-identyclaw-httpbearer-plugin/issues"
  },
  "homepage": "https://www.discernible.io/#developers",
  "peerDependencies": {
    "openclaw": ">=2026.9.7"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.9.7",
      "minGatewayVersion": "2026.9.7"
    },
    "build": {
      "openclawVersion": "2026.9.7",
      "pluginSdkVersion": "2026.9.7"
    }
  },
  "devDependencies": {
    "openclaw": "2026.9.7"
  }
}
